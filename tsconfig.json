{
  "compilerOptions": {
    /* Cài đặt cơ bản */
    "target": "ES2022",
    "module": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /* Cài đặt Module */
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    /* Cài đặt Build */
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"]
}