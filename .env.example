# 1. API Key của Google Gemini
# Lấy từ: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Cổng chạy máy chủ (Server)
PORT=3000

# 3. Môi trường (development/production)
NODE_ENV=development

# 4. Cấu hình PostgreSQL Database
# Cách 1: Dùng DATABASE_URL (Neon, Heroku, Railway)
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# Cách 2: Dùng các biến riêng lẻ (Local development)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=dalat_chatbot
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SSL=false

# Note: Nếu dùng DATABASE_URL, không cần các biến DB_* bên dưới
